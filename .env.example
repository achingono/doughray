# Database
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql://finance:changeme_in_production@postgres:5432/finance

# SimpleFin Bridge (legacy provider; used until accounts migrate to Plaid)
# Run: simplefin-cli setup <base64-token> to get your access URL
SIMPLEFIN_ACCESS_URL=

# Plaid (bank provider). Get credentials from the Plaid dashboard.
# PLAID_ENV must be either "sandbox" or "production".
PLAID_CLIENT_ID=
PLAID_CLIENT_SECRET=
PLAID_ENV=sandbox
# Comma-separated list of countries supported by the linked institutions.
PLAID_COUNTRY_CODES=CA,US
# Registered OAuth return URL for the deployed frontend (required for OAuth institutions).
PLAID_REDIRECT_URI=
# Public HTTPS URL the Plaid webhooks are posted to (optional; polling-only works without it).
PLAID_WEBHOOK_URL=
# Days of transaction history requested in Link initialization. Defaults to 365.
PLAID_TRANSACTIONS_DAYS_REQUESTED=365
# Enable the separately-gated "Refresh from bank" action (/transactions/refresh).
PLAID_REFRESH_ENABLED=false
# App-side guard for the trial's connection allowance. This is not billing/quota info.
PLAID_CONNECTION_LIMIT=10
PLAID_MIGRATION_CONNECTION_LIMIT_ENABLED=true
# Optional: pin a specific Plaid API version
PLAID_API_VERSION=2020-09-14

# Dedicated encryption key for bank access tokens (server only, never in the browser).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BANK_TOKEN_ENCRYPTION_KEY=
BANK_TOKEN_ENCRYPTION_KEY_VERSION=1

# Single-owner access control for the household deployment.
# Provision a scrypt password hash:
#   See docs/plaid-setup.md for a hidden-input password provisioning command.
# Format: scrypt:<salt-hex>:<derived-key-hex>
OWNER_PASSWORD_HASH=

# OpenAI-compatible LLM provider
# Leave OPENAI_BASE_URL empty to use the default OpenAI API endpoint.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TEMPERATURE=1

# Provider-specific compatibility fallback examples (optional)
# Azure OpenAI example:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# App Settings
NODE_ENV=production
API_PORT=3000
SPA_PORT=80
# Public origin of the SPA, used for CORS and to locate the API from the browser.
CORS_ORIGIN=http://localhost
