# Database
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql://finance:changeme_in_production@postgres:5432/finance

# SimpleFin Bridge
# Run: simplefin-cli setup <base64-token> to get your access URL
SIMPLEFIN_ACCESS_URL=

# OpenAI-compatible LLM provider
# Leave OPENAI_BASE_URL empty to use the default OpenAI API endpoint.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TEMPERATURE=1

# Provider-specific compatibility fallback examples (optional)
# Azure OpenAI example:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=

# App Settings
NODE_ENV=production
API_PORT=3000
SPA_PORT=80
