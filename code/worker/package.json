{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run build --workspace=@doughray/shared",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prebuild": "npm run build --workspace=@doughray/shared",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretest": "npm run build --workspace=@doughray/shared",
    "test": "vitest run --config vitest.config.ts",
    "pretest:coverage": "npm run build --workspace=@doughray/shared",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@doughray/shared": "*",
    "@prisma/client": "^6.5.0",
    "node-cron": "^3.0.0",
    "@azure/openai": "^2.0.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.0",
    "typescript": "^5.7.0",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.0"
  }
}
